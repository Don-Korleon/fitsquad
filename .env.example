# Telegram — получите у @BotFather (/newbot)
BOT_TOKEN=
BOT_USERNAME=fitsquad_bot
# Случайная строка 32+ символов (openssl rand -hex 32)
WEBHOOK_SECRET=change-me-webhook-secret
# Публичный HTTPS URL сервера (без trailing slash)
PUBLIC_URL=https://your-domain.com

# Server
PORT=3000
NODE_ENV=development
# Локально: false (long polling). Production: true (webhook)
USE_WEBHOOK=false

# Mini App — ТОЛЬКО https:// (локально: ngrok http 3000)
WEBAPP_URL=https://your-domain.com/webapp/

# AI: mock = шаблоны | live = OpenAI (нужен OPENAI_API_KEY)
API_MODE=mock
OPENAI_API_KEY=

# Команды и FS-токены (можно не менять)
MAX_TEAM_SIZE=5
FS_WORKOUT_COMPLETE=10
FS_PHOTO_VERIFIED=15
FS_TEAM_BONUS=25
# Premium (Telegram Stars)
PREMIUM_PRICE_STARS=99
PREMIUM_DAYS=30
PREMIUM_FS_MULTIPLIER=1.5

# appss.pro — код с экрана Verify (ответ бота на /appss_verify)
# Скопируйте код из appss.pro → Vercel → redeploy → /appss_verify в боте
APPSS_VERIFY_SECRET=
