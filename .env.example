# Telegram — получите у @BotFather (/newbot)
BOT_TOKEN=
BOT_USERNAME=fitsquad_bot
# Случайная строка 32+ символов (openssl rand -hex 32)
WEBHOOK_SECRET=change-me-webhook-secret
# Публичный HTTPS URL сервера (без trailing slash)
PUBLIC_URL=https://your-domain.com

# Server
PORT=3000
NODE_ENV=development
# Локально: false (long polling). Production: true (webhook)
USE_WEBHOOK=false

# Mini App — ТОЛЬКО https:// (локально: ngrok http 3000)
WEBAPP_URL=https://your-domain.com/webapp/

# AI: mock = шаблоны | live = OpenAI (нужен OPENAI_API_KEY)
API_MODE=mock
OPENAI_API_KEY=

# Команды и FS-токены (можно не менять)
MAX_TEAM_SIZE=5
FS_WORKOUT_COMPLETE=10
FS_PHOTO_VERIFIED=15
FS_TEAM_BONUS=25
# Premium (Telegram Stars)
PREMIUM_PRICE_STARS=99
PREMIUM_DAYS=30
PREMIUM_FS_MULTIPLIER=1.5

# Tribute — промокоды и подписки (https://wiki.tribute.tg)
# API key из настроек автора Tribute (для проверки webhook trbt-signature)
TRIBUTE_API_KEY=
# Ссылка с промокодом из кабинета Tribute → Promo Codes
TRIBUTE_PROMO_LINK=
# Ссылка на подписку или цифровой товар (t.me/tribute/app?startapp=...)
TRIBUTE_SUBSCRIPTION_LINK=
TRIBUTE_PRODUCT_LINK=
# Опционально: фильтровать webhook по ID из Tribute
# TRIBUTE_SUBSCRIPTION_ID=
# TRIBUTE_PRODUCT_ID=
TRIBUTE_YEAR_DAYS=365

# appss.pro — опционально; код можно задать в боте: /appss_verify КОД_ИЗ_ПОЛЯ_ОТВЕТ
APPSS_VERIFY_SECRET=

# Telegram ID владельца(ев) бота через запятую — единственные, кто может использовать /appss_verify.
# Узнать свой ID: напишите @userinfobot
ADMIN_TELEGRAM_IDS=

# Turso (required on Vercel for persistent data; local dev can omit and use file:data/fitsquad.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
